# Database (local dev falls back to file:local.db if unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Security
ENCRYPTION_KEY=        # 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=           # Generate: npx auth secret

# Storage
BLOB_READ_WRITE_TOKEN=

# Platform-default Twilio Verify (sub-accounts can override)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Address lookup
ROYAL_MAIL_ADDRESS_VALIDATION_API=   # UK
GOOGLE_MAPS_API_KEY=                 # International (Places API New)
